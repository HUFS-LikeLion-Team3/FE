# Empty uses the local Vite proxy; production must set the public API origin.
VITE_API_BASE_URL=
# Vite server only, never exposed to browser code.
API_PROXY_TARGET=http://localhost:8082

# DEV only: mock APIs still unfinished in the 2026-10-11 specification.
# false connects every endpoint to the backend; production never includes mocks.
VITE_MOCK_LEARNING_API=false
VITE_KAKAO_CLIENT_ID=dd3945acdcb4b72bfa313a4d039e45bc
